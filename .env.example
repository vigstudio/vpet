POSTGRES_DB=vpet
POSTGRES_USER=vpet
POSTGRES_PASSWORD=replace-with-a-long-random-password
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
VPET_PORT=8080
# 0.0.0.0 exposes the app directly; keep 127.0.0.1 when a reverse proxy fronts it.
VPET_BIND=127.0.0.1
# Generate: openssl rand -hex 32
TRANSFER_SECRET=replace-with-64-hex-characters
